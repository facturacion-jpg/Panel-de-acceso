# ============================================================
# .env.example - Cotizador de Muestras
# Copie este archivo como ".env" (en la misma carpeta) y
# ajuste los valores según su entorno. INICIAR.bat / INICIAR-WIFI.bat
# cargan .env automáticamente si existe.
# ============================================================

# --- Servidor ---
# Puerto HTTP del servidor (por defecto 3100).
PORT=3100

# Interfaz de red donde escucha. Use 0.0.0.0 para permitir acceso desde
# otros equipos de la red local; 127.0.0.1 solo permite acceso local.
HOST=0.0.0.0

# Carpeta donde se guardan catalog.json, store.json, backups, exports y audit.log.
# Por defecto ./data. En Docker/Render con disco persistente use /var/data.
# En Render Free (sin disco) se usa /opt/render/project/src/data (efímera).
# DATA_DIR=./data

# URL pública/base usada en los enlaces de descarga de Excel enviados por correo.
# INICIAR-WIFI.bat la detecta automáticamente como http://<IP_LOCAL>:3100.
# En producción coloque la URL real, sin barra final (ej. https://cotizador.miempresa.com).
# PUBLIC_BASE_URL=http://192.168.1.50:3100

# IP LAN opcional para enlaces de correo cuando no se usa PUBLIC_BASE_URL.
# LAN_IP=192.168.1.50

# --- Seguridad ---
# Autenticación básica HTTP (navegador pedirá usuario/contraseña).
# En producción (NODE_ENV=production) son OBLIGATORIAS o el servidor no arranca.
# BASIC_AUTH_USER=usuario
# BASIC_AUTH_PASS=cambie_esta_clave

# Token requerido en el header X-Admin-Token para TODA operación de escritura
# (guardar, importar, restaurar, borrar, generar Excel, etc.). La interfaz lo
# solicita una vez por pestaña y lo mantiene solo en memoria.
# En producción es OBLIGATORIO o el servidor no arranca.
# ADMIN_TOKEN=cambie_este_token_admin

# Orígenes permitidos para CORS (frontend en otro dominio), separados por coma.
# Vacío = CORS desactivado. "*" está prohibido en NODE_ENV=production.
# CORS_ORIGIN=https://app.miempresa.com

# Modo solo lectura: 1 permite consultar/calcular/exportar pero bloquea guardados.
# READ_ONLY=1

# Confíe en X-Forwarded-For solo detrás de proxy confiable (Render/Nginx). 1=activo.
# TRUST_PROXY=1

# Header con usuario autenticado para audit.log (solo si TRUST_PROXY=1).
# AUDIT_USER_HEADER=x-authenticated-user

# --- Retención / límites ---
# EXPORT_MAX_FILES=60
# EXPORT_RETENTION_DAYS=7
# BACKUP_RETENTION=10
# MIN_FREE_BYTES=209715200
